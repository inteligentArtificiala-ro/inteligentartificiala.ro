---
/**
 * Butonul care deschide în Google Colab notebookul Jupyter al unui laborator, citit din repozitoriul site-ului de pe
 * GitHub, și legătura de descărcare a aceluiași fișier de pe site.
 *
 * ```mdx
 * import Colab from '@components/Colab.astro';
 *
 * <Colab notebook="laboratoare/difuzie-imagini-si-sunete/difuzie-imagini-si-sunete.ipynb" />
 * ```
 *
 * Colab citește fișierul de pe ramura `main`, așa că un notebook nou se deschide abia după ce ajunge pe GitHub.
 * Pagina nu încarcă nimic de la Google: logoul este desenat în ColabLogo.astro, iar Colab primește vizitatorul doar
 * după clic. Dedesubt apare ultima rulare automată a notebookului (VerificareLaborator.astro).
 */
import { colabUrl, verificaNotebook } from '../utils/notebooks';
import { laboratorulNotebookului } from '../utils/verificari';
import ColabLogo from './ColabLogo.astro';
import VerificareLaborator from './VerificareLaborator.astro';

interface Props {
  /** Calea notebookului, relativă la public/. */
  notebook: string;
}

const { notebook } = Astro.props;
verificaNotebook(notebook);
const colab = colabUrl(notebook);
---

<div class='colab not-content' data-pagefind-ignore>
  <p class='butoane'>
    <a class='deschidere' href={colab}>
      <ColabLogo />
      Deschidere în Google Colab
    </a>
    <a class='descarcare' href={`/${notebook}`} download>Descărcare notebook</a>
  </p>
  <VerificareLaborator laborator={laboratorulNotebookului(notebook)} />
</div>

<style>
  .colab {
    margin-block: 1.25rem;
    font-family: var(--sl-font);
  }

  .butoane {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin: 0;
  }

  /* La începutul paginii, butonul stă imediat sub titlu, fără spațiul de deasupra. */
  .colab:first-child {
    margin-top: 0;
  }

  .deschidere {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem 0.4rem 0.7rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
  }

  .deschidere:hover,
  .deschidere:focus-visible {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }

  .descarcare {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .descarcare:hover {
    color: var(--sl-color-white);
  }
</style>
