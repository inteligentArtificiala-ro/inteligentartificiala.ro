---
// Ordinea în care apar tokenurile unui răspuns. Un model autoregresiv adaugă câte un token, de la stânga la dreapta, la
// fiecare trecere prin rețea. Un model de difuzie cu mască fixează mai multe tokenuri la fiecare trecere, întâi pe cele
// de care este cel mai sigur. Ordinea din panoul de difuzie este ilustrativă.
import '../../styles/diagrams.css';
import Box from './Box.astro';

const TOKENS = ['Pisica', 'neagră', 'doarme', 'pe', 'covor', '.'];
// Trecerea la care este fixat fiecare token în difuzie: întâi „pe” și punctul, apoi restul.
const DIFFUSION_PASS = [2, 3, 2, 1, 3, 1];
const CELL = 48;
const GAP = 3;
const ROW = 32;
const BOX_HEIGHT = 24;
const TOP = 62;
const PANEL_WIDTH = TOKENS.length * (CELL + GAP) - GAP;
const PANEL_GAP = 36;

const panels = [
  {
    x: 28,
    title: 'Autoregresiv',
    subtitle: 'un token la fiecare trecere',
    passes: 6,
    passOf: (i: number) => i + 1,
    masks: false,
  },
  {
    x: 28 + PANEL_WIDTH + PANEL_GAP,
    title: 'Difuzie cu mască',
    subtitle: 'două tokenuri la fiecare trecere',
    passes: 3,
    passOf: (i: number) => DIFFUSION_PASS[i],
    masks: true,
  },
].map((panel) => ({
  ...panel,
  rows: Array.from({ length: panel.passes }, (_, r) => ({
    pass: r + 1,
    y: TOP + r * ROW,
    // Tokenul este fixat la o trecere anterioară, chiar la aceasta, sau încă nu (mască la difuzie, nimic la modelul
    // autoregresiv, care nu are încă poziția respectivă).
    cells: TOKENS.map((text, i) => ({
      x: panel.x + i * (CELL + GAP),
      text,
      state: panel.passOf(i) < r + 1 ? 'fixed' : panel.passOf(i) === r + 1 ? 'new' : 'pending',
    })),
  })),
}));
const VIEW_WIDTH = 28 + 2 * PANEL_WIDTH + PANEL_GAP + 8;
const VIEW_HEIGHT = TOP + 6 * ROW + 30;
---

<figure class='diagram text-order-diagram'>
  <div class='diagram-scroll'>
    <svg viewBox={`0 0 ${VIEW_WIDTH} ${VIEW_HEIGHT}`} role='img' aria-labelledby='text-order-title text-order-desc'>
      <title id='text-order-title'>Ordinea tokenurilor la un model autoregresiv și la un model de difuzie cu mască</title>
      <desc id='text-order-desc'>
        Același răspuns, „Pisica neagră doarme pe covor.”, generat în două feluri. Modelul autoregresiv face șase
        treceri prin rețea și adaugă la fiecare câte un token, de la stânga la dreapta. Modelul de difuzie cu mască
        pornește de la șase măști și face trei treceri. La prima fixează „pe” și punctul, la a doua „Pisica” și
        „doarme”, iar la a treia „neagră” și „covor”.
      </desc>

      {
        panels.map((panel) => (
          <g>
            <text class='title' x={panel.x} y='24'>
              {panel.title}
            </text>
            <text class='label' x={panel.x} y='44'>
              {panel.subtitle}
            </text>
            {panel.rows.map((row) => (
              <g>
                <text class='label' x={panel.x - 8} y={row.y + BOX_HEIGHT / 2 + 4} text-anchor='end'>
                  {row.pass}
                </text>
                {row.cells.map((cell) =>
                  cell.state === 'fixed' ? (
                    <Box x={cell.x} y={row.y} width={CELL} height={BOX_HEIGHT} kind='neutral' lines={[cell.text]} />
                  ) : cell.state === 'new' ? (
                    <Box x={cell.x} y={row.y} width={CELL} height={BOX_HEIGHT} kind='highlight' lines={[cell.text]} />
                  ) : panel.masks ? (
                    <Box x={cell.x} y={row.y} width={CELL} height={BOX_HEIGHT} kind='mask' lines={['[M]']} dashed />
                  ) : null,
                )}
              </g>
            ))}
            <text class='label' x={panel.x} y={TOP + panel.passes * ROW + 14}>
              {panel.passes} treceri prin rețea
            </text>
          </g>
        ))
      }
    </svg>
  </div>
  <figcaption>
    Fiecare rând este o trecere prin rețea. Tokenurile fixate la trecerea respectivă sunt evidențiate, iar [M] este
    tokenul de mască. Ordinea din dreapta este ilustrativă.
  </figcaption>
</figure>

<style>
  .text-order-diagram svg {
    min-width: 34rem;
    max-width: 44rem;
  }
</style>
